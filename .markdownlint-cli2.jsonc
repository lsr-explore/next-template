{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Allow long lines (common in docs with URLs and tables)
    "MD013": false,
    // Allow duplicate headings in different sections
    "MD024": { "siblings_only": true },
    // Allow inline HTML (needed for badges, details/summary, etc.)
    "MD033": false,
    // Allow fenced code blocks without a language (common in docs)
    "MD040": false,
    // Disable strict table column alignment
    "MD060": false
  },
  "ignores": [
    "node_modules/**",
    ".next/**",
    "storybook-static/**",
    "coverage/**",
    "CHANGELOG.md",
    ".github/pull_request_template.md"
  ]
}
