{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "------------------- dev -------------------": "noop",
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "tree": "tree -l 3 --ignore 'node_modules, coverage, .next, playwright-report, test-results, storybook-static, .nx'",
    "------------------- code quality -------------------": "noop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint:all": "biome check . && eslint . && stylelint '**/*.css' && markdownlint-cli2 '**/*.md'",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm lint:md && pnpm i18n:check && pnpm typecheck && pnpm test",
    "------------------- testing -------------------": "noop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:list": "vitest list",
    "test:ui": "vitest --ui",
    "------------------- e2e -------------------": "noop",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "------------------- storybook -------------------": "noop",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "------------------- static analysis -------------------": "noop",
    "circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src/ libs/",
    "depcruise": "depcruise src libs --config .dependency-cruiserrc.mjs",
    "depcruise:graph": "depcruise src --include-only '^src' --config .dependency-cruiserrc.mjs --output-type dot | dot -T svg | depcruise-wrap-stream-in-html > dependency-graph.html && open dependency-graph.html",
    "size": "size-limit",
    "i18n:check": "i18n-check --locales messages --source en --format next-intl",
    "i18n:check:unused": "i18n-check --locales messages --source en --format next-intl --only missingKeys,invalidKeys,unused --unused src",
    "------------------- docker -------------------": "noop",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down --rmi local --volumes --remove-orphans",
    "------------------- dependencies -------------------": "noop",
    "outdated": "pnpm outdated",
    "------------------- cleanup -------------------": "noop",
    "clean": "rm -rf .next out dist .vercel storybook-static",
    "clean:tests": "rm -rf coverage test-output test-results playwright-report *.lcov",
    "clean:all": "pnpm clean && pnpm clean:tests && rm -rf node_modules",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.11.1",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.4.9",
    "@chromatic-com/storybook": "^5.1.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@lingual/i18n-check": "^0.9.3",
    "@next/bundle-analyzer": "^16.2.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.0.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-next": "16.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.3.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.22.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.58.2",
    "size-limit": "^12.0.1",
    "storybook": "^10.3.3",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.1.4"
  },
  "size-limit": [
    {
      "name": "JS (First Load)",
      "path": ".next/static/chunks/**/*.js",
      "limit": "300 kB",
      "gzip": true
    },
    {
      "name": "CSS",
      "path": ".next/static/chunks/**/*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ]
}
